<% pageTitle = 'Ledger Exports'; active = 'ledger-exports'; %>
<%- include('partials/layout-top', { pageTitle, active, admin }) %>

<h1 class="serif">Ledger Exports</h1>
<p class="subtle">At 00:00 on the 1st of every month the system saves the previous month's ledger as a CSV file. The files appear here, and your n8n workflow can pick them up automatically.</p>

<div class="card">
  <table>
    <thead><tr><th>Period</th><th>File</th><th>Size</th><th>Created</th><th></th></tr></thead>
    <tbody id="rows"><tr><td colspan="5">Loading...</td></tr></tbody>
  </table>
</div>

<script>
  (async () => {
    const res = await fetch('/api/admin/ledger-exports');
    if (!res.ok) { window.location.href = '/admin/login.html'; return; }
    const list = await res.json();
    const label = (m) => {
      if (m === 'all') return 'Entire ledger';
      const [y, mo] = m.split('-').map(Number);
      return new Date(y, mo - 1, 1).toLocaleDateString(undefined, { year: 'numeric', month: 'long' });
    };
    document.getElementById('rows').innerHTML = list.length ? list.map(f => `
      <tr>
        <td>${label(f.month)}</td>
        <td>${f.file}</td>
        <td>${(f.size / 1024).toFixed(1)} KB</td>
        <td>${fmtDate(f.modified)}</td>
        <td><a class="btn" href="/api/admin/ledger-exports/${f.file}">Download CSV</a></td>
      </tr>`).join('') : '<tr><td colspan="5">No exports yet. The first one is created at 00:00 on the 1st of next month.</td></tr>';
  })();
</script>

<%- include('partials/layout-bottom') %>
